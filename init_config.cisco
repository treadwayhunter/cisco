hostname {{ HOSTNAME }}
!
line con 0
 logging sync
!
username treadwayh secret 0 {{ USER_PASSWORD }}
enable secret 0 {{ USER_PASSWORD }}
ip domain-name huntertreadway.com
crypto key generate rsa modulus 2048
ip ssh version 2
!
line con 0
 login local
!
line vty 0 7
 login local
 transport output ssh
 transport input ssh
 transport preferred none
!
int lo0
 ip address {{ LOOPBACK_ADDR }} 255.255.255.255
 no shut
!
end
copy run start
